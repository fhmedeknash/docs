{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "HAAT Integration Docs",
  "description": "Partner integration kits for connecting POS and delivery systems to HAAT.",
  "colors": {
    "primary": "#E85D04",
    "light": "#FF9F1C",
    "dark": "#9B2226"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Manrope",
    "heading": {
      "family": "Sora",
      "weight": 700
    },
    "body": {
      "family": "Manrope",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "icon": "house",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction"
            ]
          }
        ]
      },
      {
        "tab": "Market",
        "icon": "store",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "kits/market/overview",
              "kits/market/setup"
            ]
          },
          {
            "group": "Catalog",
            "pages": [
              "kits/market/build-menu",
              "kits/market/promotions"
            ]
          },
          {
            "group": "Orders",
            "pages": [
              "kits/market/submit-order"
            ]
          },
          {
            "group": "Sync to HAAT",
            "pages": [
              "kits/market/login",
              "kits/market/sync-products"
            ]
          },
          {
            "group": "Go-live",
            "pages": [
              "kits/market/checklist"
            ]
          }
        ]
      },
      {
        "tab": "Restaurant",
        "icon": "utensils",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "kits/restaurant/overview",
              "kits/restaurant/setup"
            ]
          },
          {
            "group": "Menu",
            "pages": [
              "kits/restaurant/get-menu"
            ]
          },
          {
            "group": "Orders",
            "pages": [
              "kits/restaurant/create-order"
            ]
          },
          {
            "group": "Go-live",
            "pages": [
              "kits/restaurant/checklist"
            ]
          }
        ]
      },
      {
        "tab": "Advanced API",
        "icon": "plug",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "kits/advanced-api/overview",
              "kits/advanced-api/setup"
            ]
          },
          {
            "group": "Businesses",
            "pages": [
              "kits/advanced-api/list-businesses",
              "kits/advanced-api/update-status",
              "kits/advanced-api/working-hours",
              "kits/advanced-api/availability"
            ]
          },
          {
            "group": "Orders",
            "pages": [
              "kits/advanced-api/prepare-time",
              "kits/advanced-api/order-status"
            ]
          },
          {
            "group": "Sync",
            "pages": [
              "kits/advanced-api/request-status"
            ]
          },
          {
            "group": "Go-live",
            "pages": [
              "kits/advanced-api/checklist"
            ]
          }
        ]
      },
      {
        "tab": "DaaS",
        "icon": "truck",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "kits/daas/overview",
              "kits/daas/setup"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "kits/daas/login"
            ]
          },
          {
            "group": "Businesses",
            "pages": [
              "kits/daas/list-businesses",
              "kits/daas/update-business"
            ]
          },
          {
            "group": "Orders",
            "pages": [
              "kits/daas/validate-order",
              "kits/daas/submit-order",
              "kits/daas/order-status",
              "kits/daas/cancel-order"
            ]
          },
          {
            "group": "Go-live",
            "pages": [
              "kits/daas/checklist"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "HAAT",
        "href": "https://haat.delivery"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Choose a kit",
      "href": "/introduction"
    }
  },
  "footer": {
    "socials": {
      "website": "https://haat.delivery"
    }
  }
}
