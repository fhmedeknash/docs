{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "HAAT Integration Docs",
  "description": "Partner integration kits for connecting POS and delivery systems to HAAT.",
  "colors": {
    "primary": "#E85D04",
    "light": "#FF9F1C",
    "dark": "#9B2226"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Manrope",
    "heading": {
      "family": "Sora",
      "weight": 700
    },
    "body": {
      "family": "Manrope",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "icon": "house",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction"
            ]
          }
        ]
      },
      {
        "tab": "Market",
        "icon": "store",
        "groups": [
          {
            "group": "Market partner kit",
            "pages": [
              "kits/market/overview",
              "kits/market/setup",
              "kits/market/menu-and-promotions",
              "kits/market/submit-order",
              "kits/market/sync-to-haat",
              "kits/market/checklist"
            ]
          }
        ]
      },
      {
        "tab": "Restaurant",
        "icon": "utensils",
        "groups": [
          {
            "group": "Restaurant partner kit",
            "pages": [
              "kits/restaurant/overview",
              "kits/restaurant/setup",
              "kits/restaurant/menu-sync",
              "kits/restaurant/create-order",
              "kits/restaurant/checklist"
            ]
          }
        ]
      },
      {
        "tab": "Advanced API",
        "icon": "plug",
        "groups": [
          {
            "group": "Advanced API partner kit",
            "pages": [
              "kits/advanced-api/overview",
              "kits/advanced-api/setup",
              "kits/advanced-api/status-and-hours",
              "kits/advanced-api/availability",
              "kits/advanced-api/checklist"
            ]
          }
        ]
      },
      {
        "tab": "DaaS",
        "icon": "truck",
        "groups": [
          {
            "group": "DaaS partner kit",
            "pages": [
              "kits/daas/overview",
              "kits/daas/setup",
              "kits/daas/businesses",
              "kits/daas/orders",
              "kits/daas/checklist"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "HAAT",
        "href": "https://haat.delivery"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Choose a kit",
      "href": "/introduction"
    }
  },
  "footer": {
    "socials": {
      "website": "https://haat.delivery"
    }
  }
}
